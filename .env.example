# Application Configuration
APP_NAME=gin-starter-pack
APP_PORT=8080
APP_ENV=development # development, production, test

# Database Configuration
# Supported drivers: postgres, mysql, sqlite (or custom registered driver)
DB_DRIVER=sqlite

# Optional: Direct DSN connection string (overrides individual host/port fields if set)
# Examples:
# DB_DSN=postgres://user:password@localhost:5432/app_db?sslmode=disable
# DB_DSN=user:password@tcp(localhost:3306)/app_db?charset=utf8mb4&parseTime=True
# DB_DSN=app.db
DB_DSN=

# SQLite settings (used when DB_DRIVER=sqlite and DB_DSN is empty)
DB_NAME=app.db

# PostgreSQL / MySQL settings (used when DB_DRIVER=postgres or mysql)
DB_HOST=localhost
DB_PORT=5432 # 5432 for postgres, 3306 for mysql
DB_USER=postgres
DB_PASSWORD=postgres
DB_SSLMODE=disable # disable, require, verify-full (postgres only)
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=10
DB_CONN_MAX_LIFETIME=15 # in minutes

# Redis Configuration
# Toggle Redis on (true) or off (false)
REDIS_ENABLED=false
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# JWT Configuration
JWT_SECRET=super-secret-key-change-me-in-production
JWT_EXPIRY_HOURS=24

# Mail / SMTP Configuration
# Use "log" driver for local dev/testing or "smtp" for remote mail server
MAIL_DRIVER=log
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS=noreply@example.com
MAIL_FROM_NAME="Gin Starter Pack"
MAIL_ENCRYPTION=tls

# Logging Configuration (Pluggable Drivers: stdout, console, file, stack, discard, or custom registered 3rd-party)
LOG_DRIVER=stack # stdout (recommended for Docker/K8s), file (local rotating), stack (both), discard (silent)
LOG_FORMAT=json # json (structured for production/ELK/Datadog/Loki) or text (human-friendly for dev)
LOG_LEVEL=info # debug, info, warn, error
LOG_DIR=logs
LOG_FILENAME=app.log
LOG_MAX_SIZE_MB=100
LOG_MAX_BACKUPS=30
LOG_MAX_AGE_DAYS=30
LOG_COMPRESS=true

# CORS Configuration
# Allowed origins supports JSON array format or comma-separated list
# Example specific domains: ["http://localhost:3000","http://localhost:5173","https://example.com"]
# Use ["*"] or * for wildcard
CORS_ALLOWED_ORIGINS=["http://localhost:3000","http://localhost:5173","https://example.com"]
CORS_ALLOWED_METHODS=GET,POST,PUT,PATCH,DELETE,OPTIONS
CORS_ALLOWED_HEADERS=Content-Type,Authorization,X-Requested-With,Accept
CORS_ALLOW_CREDENTIALS=true

# Rate Limiting Configuration (IP Token Bucket)
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=20.0
RATE_LIMIT_BURST=40

# Background Worker Configuration
WORKER_CONCURRENCY=5
WORKER_QUEUE_SIZE=100
